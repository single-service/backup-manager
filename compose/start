#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

# cron запускает задачи с пустым окружением (PATH=/usr/bin:/bin, без переменных
# из env_file), поэтому сохраняем окружение контейнера, чтобы cronfile его подгрузил
export -p > /etc/container_env.sh
chmod 600 /etc/container_env.sh

# Запуск cron в фоновом режиме
cron

python manage.py collectstatic --noinput
python manage.py migrate
python manage.py init_admin
exec gunicorn config.wsgi:application --bind 0.0.0.0:8009 --reload --workers 4
